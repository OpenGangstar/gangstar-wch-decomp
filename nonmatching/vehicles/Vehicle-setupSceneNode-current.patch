+void Vehicle::setupSceneNode(int id, irr::scene::ISceneNode* node, int count, void** params)
+{
+    LevelObject::setupSceneNode(id, node, count, params);
+    irr::IrrlichtDevice* device = Application::GetInstance()->GetDevice();
+    irr::video::IVideoDriver* driver = device->getVideoDriver();
+    GS3DStuff::SetColor(node, irr::video::SColor(255, 102, 102, 102), GS3DStuff::Color3);
+    GS3DStuff::SetColor(node, irr::video::SColor(255, 229, 229, 229), GS3DStuff::Color2);
+
+    CustomBillboardSceneNode* billboard = static_cast<CustomBillboardSceneNode*>(
+        static_cast<irr::collada::CSceneNode*>(node));
+    params[0] = reinterpret_cast<const BillboardVehicleView*>(billboard)->record->value;
+    irr::scene::ISceneNodeAnimator* animator = irr::collada::CColladaDatabase::constructAnimator(
+        init768, &irr::collada::CColladaDatabase::DefaultFactory);
+    node->addAnimator(animator);
+    params[1] = animator;
+    animator->drop();
+
+    animator = irr::collada::CColladaDatabase::constructAnimator(
+        init772, &irr::collada::CColladaDatabase::DefaultFactory);
+    node->addAnimator(animator);
+    params[2] = animator;
+    animator->drop();
+
+    const char* morphUID = vehicleSetupBodyMorph;
+    params[3] = node->getSceneNodeFromUID(vehicleSetupLeftDoor);
+    params[4] = node->getSceneNodeFromUID(vehicleSetupRightDoor);
+    params[5] = node->getSceneNodeFromUID(morphUID);
+    params[6] = node->getSceneNodeFromUID(vehicleSetupInterior);
+    params[7] = driver->getTexture(vehicleSetupBaseTexture);
+    params[8] = driver->getTexture(vehicleSetupDamageTexture);
+    params[9] = node->getSceneNodeFromUID(morphUID);
+
+    irr::scene::ISceneNode* shadow = node->getSceneNodeFromUID(vehicleSetupShadow);
+    shadow->getChildren().begin()->value->setRenderingLayer(1);
+    GS3DStuff::SetColor(shadow, irr::video::SColor(255, 0, 0, 0), GS3DStuff::Color3);
+    GS3DStuff::SetColor(shadow, irr::video::SColor(255, 255, 255, 255), GS3DStuff::Color0);
+    GS3DStuff::SetColor(shadow, irr::video::SColor(255, 255, 255, 255), GS3DStuff::Color1);
+    GS3DStuff::SetColor(shadow, irr::video::SColor(255, 255, 255, 255), GS3DStuff::Color2);
+    GS3DStuff::SetMaterialFlag(shadow, irr::video::MaterialFlag1024, false);
+    GS3DStuff::SetMaterialFlag(shadow, irr::video::MaterialFlag512, false);
+    GS3DStuff::SetMaterialFlag(shadow, irr::video::MaterialFlag4, true);
+    device->getSceneManager()->getRootSceneNode()->addChild(shadow);
+    params[10] = shadow;
+
+    params[11] = node->getSceneNodeFromUID(vehicleSetupWheelFL);
+    params[12] = node->getSceneNodeFromUID(vehicleSetupWheelFR);
+    params[13] = node->getSceneNodeFromUID(vehicleSetupWheelBL);
+    params[14] = node->getSceneNodeFromUID(vehicleSetupWheelBR);
+    params[15] = node->getSceneNodeFromUID(vehicleSetupCarBody);
+    irr::scene::ISceneNode* smoke = node->getSceneNodeFromUID(vehicleSetupSmokeNode);
+    params[16] = smoke;
+    if (smoke) {
+        params[17] = reinterpret_cast<void*>(SceneNodeManager::getInstance()->findOrCreatePool(
+            vehicleSetupSmokeScene, 5, _ZN12CGameFactory11getInstanceEv()));
+        params[18] = reinterpret_cast<void*>(SceneNodeManager::getInstance()->findOrCreatePool(
+            vehicleSetupFireScene, 5, _ZN12CGameFactory11getInstanceEv()));
+    }
+}
