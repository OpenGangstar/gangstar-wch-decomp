+    const float front = halfWidth + reinterpret_cast<irr::scene::ISceneNode*>(skinnedMesh)->getBoundingBox().MinEdge.Y / 100.0f;
+    const float rear = reinterpret_cast<irr::scene::ISceneNode*>(skinnedMesh)->getBoundingBox().MaxEdge.Y / 100.0f - halfWidth;
+
+    b2PolygonDef hull;
+    hull.vertices[0] = b2Vec2(-halfWidth, front);
+    hull.vertices[1] = b2Vec2(halfWidth, front);
+    hull.vertices[2] = b2Vec2(halfWidth, rear);
+    hull.vertices[3] = b2Vec2(-halfWidth, rear);
+    hull.vertexCount = 4;
+    hull.density = 1.0f;
+    hull.filter.categoryBits = 8;
+    hull.filter.maskBits = 0xffff;
+    hull.filter.groupIndex = unknown24->getIndex() + 1;
+
+    b2CircleDef frontCap;
+    frontCap.filter = hull.filter;
+    frontCap.localPosition = b2Vec2(0.0f, rear);
+    frontCap.radius = halfWidth;
+    frontCap.density = 1.0f;
+
+    b2CircleDef rearCap;
+    rearCap.filter = hull.filter;
+    rearCap.localPosition = b2Vec2(0.0f, front);
