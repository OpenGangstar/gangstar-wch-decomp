+
+void Vehicle::shoot()
+{
+    Application* application = Application::GetInstance();
+    application->GetDevice()->getTimer()->getRealTime();
+    Character* shooter = driver;
+    if (!shooter)
+        return;
+    Weapon* weapon = shooter->getWeapon();
+    if (!weapon || !weapon->getWeaponType())
+        return;
+    weapon->getWeaponType();
+    if (!weapon->isReady(false))
+        return;
+    LevelObject* target = Lock::getInstance()->target;
+    if (weapon->isGun()) {
+        irr::core::vector3d<float> hitPoint;
+        irr::core::vector3d<float> shotDirection;
+        irr::core::vector3d<float> normal;
+        irr::core::vector3d<float> source = GetPosition();
+        source.Z += 100.0f;
+        if (!(target && s_type[target->getObjectType()] == 5
+            && static_cast<NPC*>(target)->isHostileTo(this))) {
+            if (shooter->isPlayer()) {
+                target = PlayerTest::getAttackableTarget(this, weapon, target);
+            } else {
+                for (LevelObject* object = GameObjectManager::s_gom->GetFirst(0); object; object = object->next) {
+                    if (s_type[object->getObjectType()] == 5 && static_cast<NPC*>(object)->isHostileTo(this)) {
+                        target = object;
+                        break;
+                    }
+                }
+            }
+        }
+        if (target) {
+            const float xVariation = (float(lrand48() % 100) - 50.0f) / 50.0f;
+            const float yVariation = (float(lrand48() % 100) - 50.0f) / 50.0f;
+            const float zVariation = float(lrand48() % 100) - 50.0f;
+            const irr::core::vector3d<float> targetPosition = target->GetPosition();
+            const int aimSetting = *reinterpret_cast<const int*>(reinterpret_cast<const char*>(shooter) + 252);
+            const float deviation = 200.0f - float(aimSetting * 2);
+            const float xSpread = xVariation * deviation;
+            const float ySpread = yVariation * deviation;
+            const float aimX = xSpread + targetPosition.X;
+            const float aimY = ySpread + targetPosition.Y;
+            const float aimZ = zVariation / 50.0f * deviation + targetPosition.Z;
+            const float deltaZ = aimZ - source.Z;
+            shotDirection.X = aimX - source.X;
+            shotDirection.Y = aimY - source.Y;
+            shotDirection.Z = deltaZ;
+            if (s_type[target->getObjectType()] == 3)
+                shotDirection.Z += 100.0f;
+            shotDirection.normalize();
+        } else {
+            shotDirection = GetFront();
+        }
+        Lock::getInstance()->setTarget(target);
+        const float range = float(weapon->getRange());
+        const bool hit = CastRay(source, shotDirection * range, hitPoint, normal, target, false);
+        if (target)
+            target->shooted(weapon->getDamage(), this);
+        irr::core::vector3d<float> end = hit ? shotDirection * 7500.0f + source : hitPoint;
+        weapon->shootFromCar(hit, source, end, normal);
+    } else if (weapon->isProjectile()) {
+        irr::core::vector3d<float> direction;
+        if (target) {
+            const irr::core::vector3d<float> targetPosition = target->GetPosition();
+            const irr::core::vector3d<float> source = GetPosition();
+            direction = targetPosition - source;
+            direction.normalize();
+        } else {
+            direction = GetFront();
+        }
+        weapon->shootProjectile(direction);
+    }
+
+    Character* currentDriver = driver;
+    Character* player = reinterpret_cast<Character*>(static_cast<SavePositionInterface*>(PlayerTest::GetPlayer()));
+    if (currentDriver != player)
+        return;
+    if (target && target->getHealth() <= 0)
+        PlayerTest::GetPlayer()->onObjectKilled(target);
+    EventManager* events = application->GetEventManager();
+    unsigned int storage[sizeof(EvPlayer) / sizeof(unsigned int)];
+    EvPlayer* event = new (storage) EvPlayer(2);
+    events->raise(*event);
+    _ZN8EvPlayerD1Ev(event);
+    if (weapon->getClip() <= 0 && application->GetWeaponManager()->getAmmo(weapon->getAmmoType(), PlayerTest::AnyContext) > 0)
+        weapon->reload(false);
+}
