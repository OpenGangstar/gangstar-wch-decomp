+#include "../characters/PlayerTest.h"
+void FollowCamera::update(float)
+{
+    if (!owner)
+        return;
+
+    const float heightDelta = position.Z - previousHeight;
+    position.Z = owner->GetPosition().Z;
+    const irr::core::vector3d<float> offset = position - owner->GetPosition();
+    const irr::core::vector3d<float> facing = getFacing();
+    const irr::core::vector3d<float> right = static_cast<PlayerTest*>(owner)->GetRight();
+    const int distanceSquared = static_cast<int>(offset.getLengthSQ());
+
+    if (distanceSquared > 450 * 450) {
+        if (flag32) {
+            const irr::core::vector3d<float> up(0.0f, 0.0f, 1.0f);
+            owner->setCameraOffset(up.crossProduct(getFacing()));
+            flag32 = false;
+        }
+        const irr::core::vector3d<float> origin = owner->GetPosition();
+        const irr::core::vector3d<float>& cameraOffset = owner->getCameraOffset();
+        irr::core::vector3d<float> nextPosition(
+            450.0f * cameraOffset.X + origin.X,
+            450.0f * cameraOffset.Y + origin.Y,
+            450.0f * cameraOffset.Z + origin.Z);
+        nextPosition.Z = owner->GetPosition().Z - owner->unknown156;
+        setPosition(nextPosition);
+    } else if (distanceSquared < 450 * 450) {
+        if (flag32) {
+            const irr::core::vector3d<float> up(0.0f, 0.0f, 1.0f);
+            owner->setCameraOffset(up.crossProduct(getFacing()));
+            flag32 = false;
+        }
+        const irr::core::vector3d<float> origin = owner->GetPosition();
+        const irr::core::vector3d<float>& cameraOffset = owner->getCameraOffset();
+        irr::core::vector3d<float> nextPosition(
+            450.0f * cameraOffset.X + origin.X,
+            450.0f * cameraOffset.Y + origin.Y,
+            450.0f * cameraOffset.Z + origin.Z);
+        nextPosition.Z = owner->GetPosition().Z - owner->unknown156;
+        setPosition(nextPosition);
+    } else {
+        flag32 = true;
+    }
+
+    previousHeight = owner->GetPosition().Z - owner->unknown156;
+    position.Z = heightDelta + previousHeight;
+    setLookAt(owner->GetPosition());
+    lookAt.Z = owner->GetPosition().Z - owner->unknown156 + 180.0f;
+}
