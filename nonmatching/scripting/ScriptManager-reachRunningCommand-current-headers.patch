+void ScriptManager::reachRunningCommand(int command)
+{
+    Script** runningScripts = new Script*[scriptCount];
+    int runningCount = 0;
+    int scriptIndex = 0;
+    if (scriptCount > scriptIndex) {
+        do {
+            if (__builtin_expect(scripts[scriptIndex]->getState() == Script::State2, 1)) {
+                runningScripts[runningCount++] = scripts[scriptIndex];
+            }
+            ++scriptIndex;
+        } while (scriptCount > scriptIndex);
+    }
+    for (int i = 0; i < runningCount; ++i)
+        runningScripts[i]->nextCommand(command);
+    ::operator delete(runningScripts);
+}
