+void ScriptManager::setState(State state)
+{
+    if (cinematicState == state)
+        return;
+
+    Application* application = Application::GetInstance();
+    switch (state) {
+    case State0:
+        application->GetHudManager()->show();
+        CameraManager::getInstance()->setTouchScreenInputs(true);
+        static_cast<SavePositionInterface&>(*s_playerTest).setNextAnimation(-1, 1, false, false, false);
+        application->GetControlManager()->unlock();
+        break;
+
+    case State4:
+        bIsInCutscene = true;
+        cinematicBars->animation = -1;
+    case State1: {
+        bIsInCutscene = true;
+        application->GetHudManager()->hide();
+        showSkipButton();
+        s_playerTest->_SetTarget(0, false);
+        reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*s_playerTest)).goToIdle();
+        CameraManager::getInstance()->setTouchScreenInputs(false);
+        CameraManager::getInstance()->updateUpVector(0.0f);
+        application->GetControlManager()->lock();
+        WantedLevelManager::getInstance()->storeWantedLevel();
+        WantedLevelManager::getInstance()->resetWantedLevel();
+        WantedLevelManager::getInstance()->lock(0);
+        GS3DStuff::forceDespawn(3);
+        GS3DStuff::forceDespawn(5);
+
+        Vehicle* vehicle = static_cast<Vehicle*>(s_playerTest->unknown316);
+        if (!vehicle || !vehicle->sceneNode || !vehicle->sceneNode->isVisible())
+            break;
+        if (vehicle->driver != 0) {
+            if (static_cast<Mission*>(getMission())->getState() == 4)
+                break;
+        }
+        if (vehicle->unknown28 && *vehicle->unknown28) {
+            if ((vehicle->unknown4 & 0x400) == 0)
+                break;
+        }
+
+        irr::core::array<OctTreeAABB::RootNode*>* roots = GS3DStuff::getSceneOctTree()->roots;
+        const irr::core::vector3d<float>& playerPosition =
+            static_cast<SavePositionInterface&>(*s_playerTest).position();
+        SpawnPoint* closest = 0;
+        float closestDistance = 0.0f;
+        for (unsigned int i = 0; i < roots->used; ++i) {
+            SpawnPoint* point = roots->data[i]->spawn;
+            if (!point || SpawnPoint::s_metatypesSpawnCst[point->spawnGroup]->type != 11)
+                continue;
+            const float distance = playerPosition.getDistanceFromSQ(point->position);
+            if ((!closest || distance < closestDistance) && !point->hasCloseNeighbors()) {
+                closest = point;
+                closestDistance = distance;
+            }
+        }
+        irr::core::vector3d<float> vehiclePosition = closest->position;
+        vehiclePosition.Z = vehicle->unknown24->GetHeight(vehiclePosition, 0, false);
+        vehicle->SetRotation(closest->rotation);
+        vehicle->SetPosition(vehiclePosition);
+        break;
+    }
+
+    case State3:
+    case State6:
+        hideSkipButton();
+        if (cutsceneSkipped) {
+            resumeBlockingCommands();
+            cutsceneSkipped = false;
+        }
+        WantedLevelManager::getInstance()->unlock();
+        WantedLevelManager::getInstance()->restoreWantedLevel();
+        s_playerTest->unknown377 = 0;
+        bIsInCutscene = false;
+        break;
+
+    default:
+        break;
+    }
+    cinematicState = state;
+}
