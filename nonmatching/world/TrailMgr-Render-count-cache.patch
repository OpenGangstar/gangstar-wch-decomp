+
+void TrailMgr::Render()
+{
+    int count = trailCount;
+    for (int i = 0; i < count; ++i) {
+        Trail* trail = trails[i];
+        if (!trail)
+            continue;
+        if (trail->points[0].remainingLife <= 0)
+            continue;
+        trail->Render();
+        count = trailCount;
+    }
+}
