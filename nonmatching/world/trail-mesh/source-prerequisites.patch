+void Trail::Update()
+{
+    activePointCount = 0;
+    for (int i = 0; i < trailPointCount; ++i) {
+        points[i].remainingLife = irr::core::max_(points[i].remainingLife - 1, 0);
+        if (points[i].remainingLife <= 0)
+            break;
+        ++activePointCount;
+    }
+
