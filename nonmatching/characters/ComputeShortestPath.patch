+void PhysicAttributes::ComputeShortestPath(int infoIndex,int mode,irr::core::vector3d<float> source,irr::core::vector3d<float> destination,float)
+{
+    PathArray closed,open;
+    PhysicInfo target;
+    m_AStarStatusIncrement+=3;
+    if(info[infoIndex].unknown8==static_cast<unsigned short>(-1)) {
+        if(open.free_when_destroyed) ::operator delete(open.data);
+        if(closed.free_when_destroyed) ::operator delete(closed.data);
+        return;
+    }
+    pathTarget=destination;
+    AStarNode first(info[infoIndex].unknown8,info[infoIndex].unknown0,static_cast<unsigned short>(-1),static_cast<unsigned short>(-1),0.0f,(source-destination).getLengthSQ());
+    open.push_back(first);
+    int selected=-1;
+    while(open.used) {
+        int index;
+        AStarNode current=FindLowerCostNode(&open,&index);
+        s_neighbors[current.region][6][static_cast<unsigned short>(current.triangleOffset/3)]=m_AStarStatusIncrement+2;
+        closed.push_back(current);
+        open.erase(index);
+        for(int edge=0;edge<3;++edge) {
+            unsigned short triangle=static_cast<unsigned short>(current.triangleOffset/3);
+            unsigned short next=s_neighbors[current.region][edge][triangle];
+            unsigned short region=s_neighbors[current.region][edge+3][triangle];
+            if(next==static_cast<unsigned short>(-1) || s_nodeCost[mode][region]==999.0f) continue;
+            if(mode==1 && ((s_neighborsWrongWay[current.region][triangle]&3)==edge+1 || ((s_neighborsWrongWay[current.region][triangle]>>2)&3)==edge+1)) continue;
+            unsigned short nextTriangle=static_cast<unsigned short>(next/3);
+            unsigned short state=s_neighbors[region][6][nextTriangle];
+            if(state==m_AStarStatusIncrement+2) continue;
+            irr::core::vector3d<float> a=GetTriCenter(current.region,current.triangleOffset);
+            irr::core::vector3d<float> b=GetTriCenter(region,next);
+            if(state==m_AStarStatusIncrement+1) {
+                int found=open.linear_reverse_search(AStarNode(next,region));
+                float cost=current.pathCost+(a-b).getLengthSQ()*s_nodeCost[mode][region];
+                if(cost<open.data[found].pathCost) {
+                    open.data[found].parentTriangleOffset=current.triangleOffset;
+                    open.data[found].parentRegion=current.region;
+                    open.data[found].cost=cost+(b-destination).getLengthSQ();
+                    open.data[found].pathCost=cost;
+                }
+            } else {
+                float cost=current.pathCost+(a-b).getLengthSQ()*s_nodeCost[mode][region];
+                AStarNode node(next,region,current.triangleOffset,current.region,cost,(b-destination).getLengthSQ());
+                s_neighbors[region][6][nextTriangle]=m_AStarStatusIncrement+1;
+                open.push_back(node);
+            }
+        }
+        selected=closed.linear_reverse_search(AStarNode(target.unknown8,target.unknown0));
+        if(selected!=-1) break;
+    }
+    pathLength=0;
+    path.clear();
+    while(selected!=-1) {
+        ++pathLength;
+        path.insert(closed.data[selected],0);
+        int next=closed.linear_reverse_search(AStarNode(closed.data[selected].parentTriangleOffset,closed.data[selected].parentRegion));
+        if(selected==next) break;
+        selected=next;
+    }
+    if(open.free_when_destroyed) ::operator delete(open.data);
+    if(closed.free_when_destroyed) ::operator delete(closed.data);
+}
