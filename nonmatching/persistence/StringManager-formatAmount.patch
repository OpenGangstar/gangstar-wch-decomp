+extern const char amountReversedNbsp[] __attribute__((visibility("hidden")));
+static const char amountHtmlSuffix[] = "&nbsp;$";
+static const char amountSpaceSuffix[] = " $";
+extern "C" char* nativeStrcat(char*, const char*);
+void strRev(char*) __attribute__((noinline));
+
+const char* StringManager::formatAmount(int amount, bool html, bool currency) const
+{
+    static const char* nbsp = amountReversedNbsp;
+    static int nbspSize = nativeStrlen(nbsp);
+    static char szBuffer[64];
+    memset(szBuffer, 0, sizeof(szBuffer));
+    char* output = szBuffer;
+    const int originalAmount = amount;
+    int remaining = amount;
+    if (!amount)
+        *output++ = '0';
+    else {
+        int digits = 0;
+        while (remaining) {
+            const int quotient = remaining / 10;
+            *output++ = remaining - quotient * 10 + '0';
+            remaining = quotient;
+            if (++digits == 3) {
+                if (remaining) switch (currentPack) {
+                case 0:
+                    *output++ = ',';
+                    break;
+                case 1:
+                    if (originalAmount <= 9999)
+                        break;
+                    // Fall through to insert a space for larger amounts.
+                    if (html) {
+                        nativeStrcat(output, nbsp);
+                        output += nbspSize;
+                    } else
+                        *output++ = ' ';
+                    break;
+                case 3:
+                    if (originalAmount <= 9999)
+                        break;
+                    // Fall through to insert a space for larger amounts.
+                    if (html) {
+                        nativeStrcat(output, nbsp);
+                        output += nbspSize;
+                    } else
+                        *output++ = ' ';
+                    break;
+                case 4:
+                    if (html) {
+                        nativeStrcat(output, nbsp);
+                        output += nbspSize;
+                    } else
+                        *output++ = ' ';
+                    break;
+                case 2:
+                    *output++ = '.';
+                    break;
+                case 5:
+                    *output++ = '.';
+                    break;
+                }
+                digits = 0;
+            }
+        }
+    }
+    if (currency) {
+        if (currentPack == 0 || currentPack == 3) {
+            *output = '$';
+            output[1] = 0;
+        } else {
+            *output = 0;
+        }
+        strRev(szBuffer);
+        switch (currentPack) {
+        case 1:
+            nativeStrcat(szBuffer, html ? amountHtmlSuffix : amountSpaceSuffix);
+            break;
+        case 2:
+            nativeStrcat(szBuffer, html ? amountHtmlSuffix : amountSpaceSuffix);
+            break;
+        case 5:
+            nativeStrcat(szBuffer, html ? amountHtmlSuffix : amountSpaceSuffix);
+            break;
+        case 4: {
+            char* end = szBuffer + nativeStrlen(szBuffer);
+            *end++ = '$';
+            *end = 0;
+            break;
+        }
+        }
+    } else {
+        *output = currency;
+        strRev(szBuffer);
+    }
+    return szBuffer;
+}
