+#include "../characters/Character.h"
+#include "../core/CameraManager.h"
+#include "../core/CameraVariants.h"
+#include "../core/Quaternion.h"
+
+class EvKeyboard : public IEvent {
+public:
+    unsigned int character;
+    int key;
+    bool pressed;
+};
+
+static int fov __attribute__((section(".data.sniper_keyboard_fov"))) = 50;
+
+void SniperControlHandler::onKeyboardEvent(const IEvent* event)
+{
+    const EvKeyboard* keyboard = static_cast<const EvKeyboard*>(event);
+    if (keyboard->pressed) {
+    PlayerTest* player = PlayerTest::GetPlayer();
+    switch (keyboard->key) {
+    case 39: {
+        Character& character = reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player));
+        character.SetRotation(character.GetRotation() * irr::core::quaternion(0.0f, 0.0f, 0.0174532925199433f));
+        break;
+    }
+    case 'D': {
+        Character& character = reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player));
+        character.SetRotation(character.GetRotation() * irr::core::quaternion(0.0f, 0.0f, 0.0174532925199433f));
+        break;
+    }
+    case 37: {
+        Character& character = reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player));
+        character.SetRotation(character.GetRotation() * irr::core::quaternion(0.0f, 0.0f, -0.0174532925199433f));
+        break;
+    }
+    case 'A': {
+        Character& character = reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player));
+        character.SetRotation(character.GetRotation() * irr::core::quaternion(0.0f, 0.0f, -0.0174532925199433f));
+        break;
+    }
+    case 38:
+        CameraManager::getInstance()->getFPSCamera()->incVerticalAngle(1.0f);
+        break;
+    case 'W':
+        CameraManager::getInstance()->getFPSCamera()->incVerticalAngle(1.0f);
+        break;
+    case 40:
+        CameraManager::getInstance()->getFPSCamera()->incVerticalAngle(-1.0f);
+        break;
+    case 'S':
+        CameraManager::getInstance()->getFPSCamera()->incVerticalAngle(-1.0f);
+        break;
+    case '1':
+        CameraManager::getInstance()->enterMode(4, reinterpret_cast<Character*>(static_cast<SavePositionInterface*>(player)), 0.3f, 0);
+        break;
+    case '2':
+        CameraManager::getInstance()->enterMode(0, reinterpret_cast<Character*>(static_cast<SavePositionInterface*>(player)), 0.3f, 0);
+        break;
+    case '3':
+        player->hideMesh();
+        reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player)).hide();
+        break;
+    case '4':
+        player->showMesh();
+        reinterpret_cast<Character&>(static_cast<SavePositionInterface&>(*player)).show();
+        break;
+    case 'E':
+        if (fov < 50)
+            CameraManager::getInstance()->getFPSCamera()->zoom(fov++);
+        break;
+    case 134:
+        if (fov < 50)
+            CameraManager::getInstance()->getFPSCamera()->zoom(fov++);
+        break;
+    case 'F':
+        if (unknown12 == 1)
+            handleAttackHeld();
+        else
+            handleAttackPressed();
+        break;
+    case 'Q':
+        if (fov > 6)
+            CameraManager::getInstance()->getFPSCamera()->zoom(fov--);
+        break;
+    case 133:
+        if (fov > 6)
+            CameraManager::getInstance()->getFPSCamera()->zoom(fov--);
+        break;
+    }
+    } else if (keyboard->key == 'F') {
+        handleAttackReleased();
+    }
+}
