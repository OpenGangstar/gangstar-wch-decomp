 }
+
+static const char beginMessage[] = "Finger pression detected";
+
+void TouchScreenBase::touchBegan(const Point2D<short>& point, long id)
+{
+    _trace(beginMessage);
+    if (slotCount < id)
+        slotCount = id + 1;
+
+    _TouchPointInfo& slot = points[id];
+    if (__builtin_expect(!slot.active, 1)) {
+        const short x = point.x;
+        const short y = point.y;
+        slot.swipeDirection = 0;
+        slot.first.x = x;
+        slot.first.y = y;
+        slot.numPoints = 1;
+    }
+
+    slot.previous = slot.current;
+    slot.current = point;
+    slot.active = true;
+    slot.hasPoints = true;
+    slot.lastTouchTime = currentTime;
+}
