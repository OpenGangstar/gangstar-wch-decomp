+#include "VehicleController.h"
+#include "../vehicles/Vehicle.h"
+class CopVehicleController : public VehicleController {
+public:
+    CopVehicleController(Vehicle* vehicle, const gameloft::ai::Transition& transition,
+        gameloft::ai::StateID state);
+    virtual ~CopVehicleController();
+    virtual void onEvent(const IEvent*, const EventManager*);
+    virtual void switchState(gameloft::ai::StateID);
+
+private:
+    int unknown28;
+};
+void AIManager::addAI(Vehicle* value, gameloft::ai::StateID initial)
+{
+    VehicleController* controller;
+    switch (value->unknown240) {
+    case 0:
+        if (initial == 0)
+            controller = new VehicleController(value, reinterpret_cast<const gameloft::ai::Transition&>(gameloft::ai::civ_vehicle), static_cast<gameloft::ai::StateID>(1));
+        else
+            controller = new VehicleController(value, reinterpret_cast<const gameloft::ai::Transition&>(gameloft::ai::civ_vehicle), initial);
+        break;
+    case 3: {
+        CopVehicleController* cop;
+        if (initial == 0)
+            cop = new CopVehicleController(value, reinterpret_cast<const gameloft::ai::Transition&>(gameloft::ai::cop_vehicle), static_cast<gameloft::ai::StateID>(1));
+        else
+            cop = new CopVehicleController(value, reinterpret_cast<const gameloft::ai::Transition&>(gameloft::ai::cop_vehicle), initial);
+        EvWantedLevelChanged event;
+        cop->onEvent(&event, Application::GetInstance()->GetEventManager());
+        controller = cop;
+        break;
+    }
+    case 6:
+        controller = new VehicleController(value, reinterpret_cast<const gameloft::ai::Transition&>(gameloft::ai::scripted_vehicle), initial);
+        break;
+    default:
+        return;
+    }
+    typedef std::allocator<stlp_priv::_List_node<IEventReceiver*> > Allocator;
+    ReceiverNode* node = reinterpret_cast<ReceiverNode*>(reinterpret_cast<Allocator*>(&secondList)->allocate(1,0));
+    node->receiver = controller;
+    node->next = &secondList;
+    ReceiverList* previous = secondList.previous;
+    node->previous = previous;
+    previous->next = node;
+    secondList.previous = node;
+}
