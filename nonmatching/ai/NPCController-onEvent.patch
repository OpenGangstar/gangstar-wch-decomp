+#include "../characters/NPCEvent.h"
+namespace gameloft { namespace ai {
+struct Transition { const unsigned int* transitions; int count; };
+} }
+void NPCController::onEvent(const IEvent* event, const EventManager*)
+{
+    switch (event->getEventID()) {
+    case 16: {
+        const EvNPC* request = static_cast<const EvNPC*>(event);
+        if (request->getNPC() != npc)
+            break;
+        const int count = transition.count;
+        if (count <= 0)
+            break;
+        const unsigned int currentState = state;
+        const unsigned int* entry = transition.transitions;
+        for (int index = 0; index < count; index += 3, entry += 3) {
+            const unsigned int from = entry[0];
+            const unsigned int condition = entry[1];
+            const unsigned int to = entry[2];
+            if (from == currentState && condition == static_cast<unsigned int>(request->getState())) {
+                switchState(static_cast<gameloft::ai::StateID>(to),
+                    static_cast<gameloft::ai::TransitionCondition>(request->getState()));
+                break;
+            }
+        }
+        break;
+    }
+    }
+}
