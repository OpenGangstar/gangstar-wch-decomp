+    }
+    void _M_reset(T* start, T* finish, T* limit) {
+        _M_buffers._M_dynamic_buf = start;
+        _M_finish = finish;
+        _M_end_of_storage._M_data = limit;
+    }
+    void _M_throw_length_error() const __attribute__((weak, noreturn));
+};
