+template<class Input, class Output>
+inline Output string_uninitialized_copy(Input first, Input last, Output result) {
+    Output current = result;
+    for (int count = last - first; count > 0; --count) {
+        std::_Copy_Construct(&*current, *first);
+        ++first;
+        ++current;
+    }
+    return current;
+}
+template<class T, class Alloc> class _String_base {
+protected:
+    enum { _DEFAULT_SIZE = 16 };
+    union _Buffers { T* _M_dynamic_buf; T _M_static_buf[_DEFAULT_SIZE]; } _M_buffers;
+    T* _M_finish;
