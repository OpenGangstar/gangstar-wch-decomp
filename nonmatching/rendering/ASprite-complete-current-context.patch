+#include "../core/ASpriteData.h"
+bool ASprite::GetPixelInfoInFrame(int frame,int x,int y,int& moduleIndex,int& color)
+{
+    ASpriteData* blob=reinterpret_cast<ASpriteData*>(data);
+    ASpriteData::Frame* entry=reinterpret_cast<ASpriteData::Frame*>(reinterpret_cast<char*>(blob)+blob->frames)+frame;
+    for(int i=0;i<entry->moduleCount;++i){
+        blob=reinterpret_cast<ASpriteData*>(data);
+        const int index=entry->firstModule+i;
+        ASpriteData::FModule* record=reinterpret_cast<ASpriteData::FModule*>(reinterpret_cast<char*>(blob)+blob->frameModules)+index;
+        ASpriteData::Module* module=reinterpret_cast<ASpriteData::Module*>(reinterpret_cast<char*>(blob)+blob->modules)+record->module;
+        if(module->kind==0){
+            ASpriteData::__rect rect;rect.left=0;rect.right=0;rect.top=0;rect.bottom=0;
+            rect.left=record->x;rect.right=module->width+record->x;
+            rect.top=record->y;rect.bottom=record->y+module->height;
+            if(rect.isIntersecting(x,y)){
+                blob=reinterpret_cast<ASpriteData*>(data);
+                ASpriteData::Image* image=reinterpret_cast<ASpriteData::Image*>(reinterpret_cast<char*>(blob)+blob->images)+module->unknown1;
+                const unsigned int row=image->unknown0*(module->unknown4-record->y+y);
+                const unsigned char* rowAddress=reinterpret_cast<unsigned char*>(blob)+image->unknown16+x+row;
+                const unsigned char pixel=rowAddress[module->unknown2-record->x];
+                moduleIndex=index;
+                const char* bytes=reinterpret_cast<const char*>(data);
+                unsigned int paletteOffset=reinterpret_cast<const unsigned int*>(bytes+image->unknown12)[1];
+                color=reinterpret_cast<const unsigned int*>(bytes+paletteOffset)[pixel]&0x00ffffffu;
+                return true;
+            }
+        }
+    }
+    return false;
+}
