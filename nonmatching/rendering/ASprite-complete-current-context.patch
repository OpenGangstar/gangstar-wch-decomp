+#include "../core/Geometry.h"
+namespace { inline int spriteAbsolute(const int& value) { return value<0 ? -value : value; } }
+void ASprite::PaintModule(int module,int x,int y,int flags) const
+{
+    if(texture) {
+    Application* app=Application::GetInstance();
+    const char* bytes=reinterpret_cast<const char*>(data);
+    const ASpriteData* blob=reinterpret_cast<const ASpriteData*>(data);
+    const ASpriteData::Module* record=reinterpret_cast<const ASpriteData::Module*>(bytes+blob->modules)+module;
+    const SpriteModule* entry=reinterpret_cast<const SpriteModule*>(record);
+    unsigned short sourceX=entry->sourceX;
+    unsigned short sourceY=entry->sourceY;
+    int width=entry->width;
+    int height=entry->height;
+    if(unknown32) {
+        bounds.left=irr::core::min_(x,bounds.left);
+        bounds.top=irr::core::min_(y,bounds.top);
+        bounds.right=irr::core::max_(bounds.right,x+width);
+        bounds.bottom=irr::core::max_(bounds.bottom,y+height);
+    } else if(entry->kind!=5) {
+    if(unknown33) { x+=165; y-=80; }
+    int clipWidth=unknown44;
+    if(clipWidth<0) clipWidth=width;
+    int clipHeight=unknown48;
+    if(clipHeight<0) clipHeight=height;
+    irr::core::rect<int> clip(x+unknown36,y+unknown40,x+clipWidth,y+clipHeight);
+    irr::core::rect<int> source(static_cast<short>(sourceX),static_cast<short>(sourceY),static_cast<short>(sourceX)+width,static_cast<short>(sourceY)+height);
+    if(flags&16) {
+        int value=source.LowerRightCorner.X;
+        source.LowerRightCorner.X=source.UpperLeftCorner.X;
+        source.UpperLeftCorner.X=value;
+    }
+    if(flags&32) {
+        int value=source.LowerRightCorner.Y;
+        source.LowerRightCorner.Y=source.UpperLeftCorner.Y;
+        source.UpperLeftCorner.Y=value;
+    }
+    app->GetDevice()->getVideoDriver()->setTransform(irr::video::ETS_WORLD,s_global_transform);
+    app->GetDevice()->getVideoDriver()->draw2DImage(texture,
+        irr::core::rect<int>(x,y,x+spriteAbsolute(source.LowerRightCorner.X-source.UpperLeftCorner.X),
+                            y+spriteAbsolute(source.LowerRightCorner.Y-source.UpperLeftCorner.Y)),
+        source,&clip,s_global_color,true);
+    app->GetDevice()->getVideoDriver()->setTransform(irr::video::ETS_VIEW,irr::core::IdentityMatrix);
+    }
+    }
+}
