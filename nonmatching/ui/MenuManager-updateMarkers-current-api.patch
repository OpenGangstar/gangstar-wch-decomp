+void MenuManager::updateMarkers()
+{
+    PlayerTest* player = PlayerTest::GetPlayer();
+    const irr::core::vector3d<float> position = player->GetPosition();
+    float playerX = position.X;
+    float playerY = position.Y;
+    Vehicle* vehicle = player->getVehicle();
+    if (vehicle) {
+        const irr::core::vector3d<float> vehiclePosition = vehicle->GetPosition();
+        playerX = vehiclePosition.X;
+        playerY = vehiclePosition.Y;
+    }
+    Map* map = Map::getInstance();
+    const float minX = map->minX;
+    const float minY = map->minY;
+    const float maxX = map->maxX;
+    const float maxY = map->maxY;
+    const float relativeX = (playerX - minX) / (maxX - minX);
+    const float relativeY = (-playerY - minY) / (maxY - minY);
+    irr::core::dimension2d<int> size;
+    Map::getInstance()->getScaledSize(size);
+    const int x = static_cast<int>(static_cast<float>(size.Width) * relativeX);
+    const int y = static_cast<int>(static_cast<float>(size.Height) * relativeY);
+    if (x >= unknown12 && y >= unknown16 && x <= unknown20 && y <= unknown24) {
+        const int offset = mapScreenX - unknown12;
+        TargetMarker* marker = TargetMarker::getInstance();
+        marker->offsetY = y - unknown16;
+        marker->offsetX = offset + x;
+        TargetMarker::getInstance()->setEnabled(true);
+    } else {
+        TargetMarker::getInstance()->setEnabled(false);
+    }
+    MiniMap* minimap = static_cast<MiniMap*>(Application::GetInstance()->GetHudManager()->minimap);
+    for (MiniMap::TrackingLink* link = minimap->trackedObjects.next;
+         link != &minimap->trackedObjects; link = link->next) {
+        MiniMap::TrackingNode* node = static_cast<MiniMap::TrackingNode*>(link);
+        if (node->flag)
+            node->marker->UpdateFrame();
+    }
+}
